rules_version = '2';
// Yokkute PME — règles d'accès. Remplacez l'adresse ci-dessous si le propriétaire change.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'baye.moustaphandiaye88@gmail.com'; }
    function member() { return get(/databases/$(database)/documents/membres/$(email())).data; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/membres/$(email())) && member().actif == true; }
    // Le responsable gestion portefeuille (rôle « chef ») a les droits d'un conseiller, plus le pilotage (tâches, réattribution, plan annuel, corrections).
    function isConseiller() { return isMember() && (member().role == 'conseiller' || member().role == 'chef'); }
    function isChef() { return isMember() && member().role == 'chef'; }
    function isMgr() { return isOwner() || isChef(); }
    function isAccueil() { return isMember() && member().role == 'accueil'; }
    function isStaff() { return isOwner() || isConseiller() || isAccueil(); }
    // Version 1.6 : agent de la Plateforme électronique (prestations numériques : étiquettes, logos, factures, supports…).
    function isPE() { return isMember() && member().role == 'pe'; }
    function canRead() { return isOwner() || isMember(); }
    // Saisie modifiable par son auteur pendant 7 jours (604 800 000 ms), date de création non modifiable.
    function auteurRecent() { return resource.data.auteur == email() && request.resource.data.auteur == email()
                              && request.resource.data.creeMs == resource.data.creeMs
                              && request.time.toMillis() - resource.data.creeMs < 604800000; }

    match /entreprises/{id} {
      allow read: if canRead();
      allow create: if isMgr() || (isConseiller() && request.resource.data.conseiller == email());
      allow update: if isMgr() || (isConseiller() && resource.data.conseiller == email() && request.resource.data.conseiller == email());
      allow delete: if isOwner();
    }
    match /bibliotheque/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /membres/{mail} {
      allow get: if isOwner() || (signedIn() && mail == email());
      allow list: if canRead();
      allow write: if isOwner();
    }
    match /taches/{id} {
      allow read: if canRead();
      // Le responsable portefeuille attribue à tous ; un conseiller crée ses propres tâches (et la suite d'une tâche répétée qui lui est attribuée).
      allow create: if isMgr() || (isConseiller() && request.resource.data.assigneA == email());
      allow delete: if isMgr() || (isConseiller() && resource.data.assigneA == email() && resource.data.creePar == email());
      allow update: if isMgr() || (isConseiller() && resource.data.assigneA == email()
                       && request.resource.data.assigneA == resource.data.assigneA
                       && (resource.data.creePar == email()
                           || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','commentaire','dateFait','realisationId','suiteCreee'])));
    }
    // Pièces justificatives : morceaux de fichiers (base64), lus par l'équipe, ajoutés par le propriétaire et les conseillers.
    match /fichiers/{id} {
      allow read: if canRead();
      allow create, update: if (isOwner() || isConseiller()) && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      allow delete: if isOwner() || isConseiller();
    }
    // Supports du formateur (guides, diaporamas, kit) : réservés au propriétaire et aux conseillers.
    match /ressources/{id} {
      allow read: if isOwner() || isConseiller();
      allow write: if isOwner();
    }
    match /ressources_parts/{id} {
      allow read: if isOwner() || isConseiller();
      allow create, update: if isOwner() && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      allow delete: if isOwner();
    }
    match /journal/{id} {
      allow read: if canRead();
      allow create: if (isStaff() || isPE()) && request.resource.data.auteur == email();
    }
    // ---- Activités CADE (version 1.2) ----
    // Journal des activités : l'accueil ne saisit que l'axe A1.
    match /realisations/{id} {
      allow read: if canRead();
      allow create: if request.resource.data.auteur == email() && request.resource.data.creeMs is number
                    && (isOwner() || isConseiller() || (isAccueil() && request.resource.data.axe == 'A1'));
      allow update: if isMgr() || (isStaff() && auteurRecent() && (!isAccueil() || request.resource.data.axe == 'A1'));
      allow delete: if isMgr() || (isStaff() && resource.data.auteur == email() && request.time.toMillis() - resource.data.creeMs < 604800000);
    }
    // Cartes d'adhésion : jamais supprimées ; le propriétaire ou le responsable portefeuille les annule (statut « Annulée »).
    match /adhesions/{id} {
      allow read: if canRead();
      allow create: if isStaff() && request.resource.data.auteur == email() && request.resource.data.creeMs is number
                    && request.resource.data.statut == 'Valide';
      allow update: if isMgr() || (isStaff() && auteurRecent() && request.resource.data.statut == resource.data.statut);
      allow delete: if false;
    }
    // Base des adhérents · version 1.7 : listes importées, rangées par lots mensuels (lot_AAAA_MM).
    // Lecture par toute l'équipe ; import et remplacement par le propriétaire ou le responsable portefeuille ; jamais supprimées.
    match /adherents/{id} {
      allow read: if canRead();
      allow create, update: if isMgr() && request.resource.data.lignes is list;
      allow delete: if false;
    }
    // Journal des recettes de la caisse · version 1.8 : PE, prestations et renouvellements repris du fichier Excel de suivi, par lots mensuels.
    match /recettes_import/{id} {
      allow read: if canRead();
      allow create, update: if isMgr() && request.resource.data.lignes is list;
      allow delete: if false;
    }
    // Recettes de la Plateforme électronique (PE) · version 1.6 : jamais supprimées ; annulées par le propriétaire ou le responsable portefeuille.
    // Toute personne qui encaisse peut marquer une commande « Livrée » ; l'auteur corrige sa saisie pendant 7 jours.
    match /recettes_pe/{id} {
      allow read: if canRead();
      allow create: if (isStaff() || isPE()) && request.resource.data.auteur == email() && request.resource.data.creeMs is number
                    && request.resource.data.statut == 'Valide';
      allow update: if isMgr()
                    || ((isStaff() || isPE()) && auteurRecent() && request.resource.data.statut == resource.data.statut)
                    || ((isStaff() || isPE()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statutCommande','livreLe','majLe','majPar','id']));
      allow delete: if false;
    }
    // Plan annuel (cibles) et référentiel des axes : modifiés par le propriétaire ou le responsable portefeuille.
    match /cade_param/{id} {
      allow read: if canRead();
      allow write: if isMgr();
    }
  }
}
