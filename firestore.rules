rules_version = '2';
// Yokkute PME — règles d'accès. Remplacez l'adresse ci-dessous si le propriétaire change.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'baye.moustaphandiaye88@gmail.com'; }
    function member() { return get(/databases/$(database)/documents/membres/$(email())).data; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/membres/$(email())) && member().actif == true; }
    function isConseiller() { return isMember() && member().role == 'conseiller'; }
    function canRead() { return isOwner() || isMember(); }

    match /entreprises/{id} {
      allow read: if canRead();
      allow create: if isOwner() || (isConseiller() && request.resource.data.conseiller == email());
      allow update: if isOwner() || (isConseiller() && resource.data.conseiller == email() && request.resource.data.conseiller == email());
      allow delete: if isOwner();
    }
    match /bibliotheque/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /membres/{mail} {
      allow get: if isOwner() || (signedIn() && mail == email());
      allow list: if canRead();
      allow write: if isOwner();
    }
    match /taches/{id} {
      allow read: if canRead();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isConseiller() && resource.data.assigneA == email()
                       && request.resource.data.assigneA == resource.data.assigneA
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','commentaire','dateFait']));
    }
    // Pièces justificatives : morceaux de fichiers (base64), lus par l'équipe, ajoutés par le propriétaire et les conseillers.
    match /fichiers/{id} {
      allow read: if canRead();
      allow create, update: if (isOwner() || isConseiller()) && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      allow delete: if isOwner() || isConseiller();
    }
    // Supports du formateur (guides, diaporamas, kit) : réservés au propriétaire et aux conseillers.
    match /ressources/{id} {
      allow read: if isOwner() || isConseiller();
      allow write: if isOwner();
    }
    match /ressources_parts/{id} {
      allow read: if isOwner() || isConseiller();
      allow create, update: if isOwner() && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      allow delete: if isOwner();
    }
    match /journal/{id} {
      allow read: if canRead();
      allow create: if (isOwner() || isConseiller()) && request.resource.data.auteur == email();
    }
  }
}
